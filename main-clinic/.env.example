# Public build-time configuration; never put service keys in VITE_* variables.
VITE_BACK_URL=/api/backend
VITE_AUTH_URL=/api/auth
VITE_CHAT_URL=https://vercel-chat-alpha.vercel.app
CHAT_PROXY_TARGET=https://vercel-chat-alpha.vercel.app
VITE_PATIENT_APP_URL=http://127.0.0.1:5182

# Development proxy targets (server-side only).
AUTH_PROXY_TARGET=http://localhost:7860
BACKEND_PROXY_TARGET=http://localhost:5001
LOCAL_CHAT_TARGET=http://127.0.0.1:5005
VITE_USE_LOCAL_CHAT=false
# LOCAL_CHAT_SERVICE_API_KEY=
